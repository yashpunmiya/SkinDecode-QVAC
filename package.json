{
  "name": "skindecode-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test:daily-skin-check": "node --experimental-strip-types --experimental-default-type=module --test tests/daily-skin-check.test.mjs",
    "test:routine": "node --experimental-strip-types --experimental-default-type=module --test tests/routine-sync.test.mjs",
    "test:intelligence": "node --experimental-strip-types --experimental-default-type=module --test tests/product-intelligence.test.mjs",
    "test:intelligence:calibration": "node --experimental-strip-types --experimental-default-type=module --test tests/product-intelligence-calibration.test.mjs",
    "test:reminders": "node --experimental-strip-types --experimental-default-type=module --test tests/reminders.test.mjs",
    "test:water": "node --experimental-strip-types --experimental-default-type=module --test tests/water-native-log-format.test.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.117.1",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.0",
    "expo-image-manipulator": "~57.0.20",
    "expo-linking": "~57.0.0",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-nitro-google-signin": "^2.3.0",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-face-detector": "^2.1.0",
    "react-native-worklets": "^0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "supabase": "^2.118.0",
    "typescript": "~6.0.3"
  }
}
