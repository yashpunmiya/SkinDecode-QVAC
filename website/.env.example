# Canonical public URL used for metadata, sitemap, robots.txt, and structured data.
NEXT_PUBLIC_SITE_URL=https://tryskindecode.online

# Required for the external account deletion page. Use the same Supabase
# project URL and anon/public key configured in the mobile app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Add only verified, monitored contact details before public launch.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_GOVERNING_LAW=

# Store links remain unset until the real listings exist.
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=
